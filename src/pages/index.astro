---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import { portfolioItems, siteConfig } from "@/data/site";
import { posts } from "@/utils/posts";

const homePortfolio = portfolioItems.slice(0, siteConfig.homePortfolioLimit || 6);
const latestPosts = posts.slice(0, 3);
---

<BaseLayout title={siteConfig.pages.home.title} description={siteConfig.pages.home.description} activePage="home" canonicalPath="/">
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art" aria-hidden="true">
        <div class="grain"></div>
        <img class="hero-piece hero-piece-main" src="/assets/portfolio/thumbs/6e89711f-d6c0-459c-9954-929687dfe61c.jpg" alt="" />
        <img class="hero-piece hero-piece-top" src="/assets/portfolio/thumbs/Gemini_Generated_Image_cpg01dcpg01dcpg0.jpg" alt="" />
        <img class="hero-piece hero-piece-bottom" src="/assets/portfolio/thumbs/f6685aea-cc53-4e4d-ab1b-499c023761af.jpg" alt="" />
      </div>
      <div class="hero-content">
        <p class="eyebrow">{siteConfig.hero.kicker}</p>
        <h1 id="hero-title">{siteConfig.hero.title}</h1>
        <p class="hero-copy">{siteConfig.hero.description}</p>
        <div class="hero-actions">
          <a class="button primary" href="#portfolio">查看作品</a>
          <a class="button secondary" href="#posts">阅读文章</a>
        </div>
      </div>
      <aside class="hero-note" aria-label="最近更新">
        <span>最近更新</span>
        <strong>{siteConfig.latest.title}</strong>
        <p>{siteConfig.latest.summary}</p>
      </aside>
    </section>

    <section class="section intro" aria-label="网站简介">
      <div>
        <p class="section-kicker">Why I Build</p>
        <h2>{siteConfig.intro.title}</h2>
      </div>
      <p>{siteConfig.intro.description}</p>
    </section>

    <section class="section" id="portfolio" aria-labelledby="portfolio-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">AI Portfolio</p>
          <h2 id="portfolio-title">精选 AI 作品</h2>
        </div>
        <a class="text-link" href="/portfolio/">全部作品</a>
      </div>
      <PortfolioGrid items={homePortfolio} home />
    </section>

    <section class="section" id="posts" aria-labelledby="posts-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Latest Posts</p>
          <h2 id="posts-title">最新文章</h2>
        </div>
        <a class="text-link" href="/posts/">全部文章</a>
      </div>
      <div class="post-grid">
        {latestPosts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
      </div>
    </section>

    <section class="section topics" id="topics" aria-labelledby="topics-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Topics</p>
          <h2 id="topics-title">常写专题</h2>
        </div>
      </div>
      <div class="topic-list">
        {siteConfig.topics.map((topic, index) => (
          <a href={`/posts/?topic=${topic.key}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{topic.title}</strong>
            <em>{topic.description}</em>
          </a>
        ))}
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="profile-photo" aria-hidden="true">
        <span>{siteConfig.about.initial}</span>
      </div>
      <div>
        <p class="section-kicker">About</p>
        <h2 id="about-title">{siteConfig.about.title}</h2>
        <p>{siteConfig.about.description}</p>
        <div class="contact-row">
          {siteConfig.links.map((link) => {
            const href = link.url.includes("@") && !link.url.startsWith("mailto:") ? `mailto:${link.url}` : link.url;
            const isExternal = href.startsWith("http");
            return (
              <a class="contact-link" href={href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined} aria-label={`${link.label}: ${link.url}`}>
                <span class="contact-label">{link.label}</span>
                <span class="contact-detail">{link.url.replace(/^mailto:/, "")}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
